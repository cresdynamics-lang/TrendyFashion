# Local Postgres on DigitalOcean droplet (production)
# For Mac local dev, tunnel first:
#   ssh -L 5432:127.0.0.1:5432 root@YOUR_DROPLET_IP
DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/trendyfashionzone
DATABASE_SSL=false

# App
NODE_ENV=development
NEXT_PUBLIC_SITE_URL=http://localhost:3000
PORT=3000

# Email (optional)
SENDGRID_API_KEY=
RESEND_API_KEY=
RESEND_FROM="Trendy Fashion Zone <onboarding@resend.dev>"
RESEND_TO_EMAIL=
RESEND_REPLY_TO=
RESEND_SUBJECT_PREFIX="Trendy Fashion Zone Contact/Call"

# Pesapal (optional)
PESAPAL_ENV=sandbox
PESAPAL_CONSUMER_KEY=
PESAPAL_CONSUMER_SECRET=
PESAPAL_CALLBACK_URL=https://trendyfashionzone.co.ke/checkout/complete
PESAPAL_IPN_LISTENER_URL=https://trendyfashionzone.co.ke/api/pesapal/ipn
PESAPAL_NOTIFICATION_ID=

# Admin fallback login
ADMIN_EMAIL=admin@trendyfashionzone.co.ke
ADMIN_PASSWORD=
ADMIN_NAME=Admin User
ADMIN_ROLE=admin

# Google Ads / Analytics
NEXT_PUBLIC_GOOGLE_ADS_ID=
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Meta Pixel + Conversions API
NEXT_PUBLIC_META_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=
META_TEST_EVENT_CODE=

# Cron
CRON_SECRET=

# Groq vision
GROQ_API_KEY=
GROQ_VISION_MODEL=qwen/qwen3.6-27b

# Gemini vision
GEMINI_API_KEY=
GEMINI_VISION_MODEL=gemini-2.0-flash
